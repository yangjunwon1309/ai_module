<launch>
  <!-- final_sg.json을 계속 래치로 제공 -->
  <node pkg="reltr_scene_graph" type="publish_final_sg.py" name="final_sg_pub" output="screen">
    <param name="path" value="$(find reltr_scene_graph)/sgg/final_sg.json"/>
    <param name="topic" value="/final_scene_graph/json"/>
  </node>

  <!-- 질의응답 노드 -->
  <node pkg="reltr_scene_graph" type="sg_query_node.py" name="sg_query" output="screen">
    <param name="path" value="$(find reltr_scene_graph)/sgg/final_sg.json"/>
    <param name="query_topic" value="/scene_graph/query"/>
    <param name="answer_topic" value="/scene_graph/answer"/>
    <param name="answer_topic_json" value="/scene_graph/answer_json"/>
  </node>
</launch>
